# ======== OpenAI (GPT-4o-mini) ========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ======== Unsplash API (free, primary image source) ========
# Get at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ======== Pexels API (free, fallback image source) ========
# Get at: https://www.pexels.com/api/
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ======== Google Cloud / YouTube Data API v3 ========
# OAuth 2.0 Client Secret JSON file path
GOOGLE_CLIENT_SECRET_PATH=config/client_secret.json

# ======== Database ========
DATABASE_PATH=autotube.db

# ======== Output ========
OUTPUT_DIR=output

# ======== Channels ========
# Comma-separated list of active channels
ACTIVE_CHANNELS=canal1,canal2

# ======== Scheduling ========
# Videos per day during week 1
WEEK1_VIDEOS_PER_DAY=1
# Videos per day during week 2
WEEK2_VIDEOS_PER_DAY=2
# Videos per day during week 3+
WEEK3_VIDEOS_PER_DAY=3

# ======== Proxy (IP residencial para YouTube API) ========
# Activar: true. Desactivar: false
PROXY_ENABLED=false
# Tipo: socks5 (túnel SSH) o http (proxy externo)
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
# Canales que usan proxy (vacío = todos)
PROXY_CHANNELS=canal2
