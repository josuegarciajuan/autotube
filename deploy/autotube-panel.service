[Unit]
Description=Autotube v2 Panel - YouTube Automation Dashboard
After=network.target network-online.target
Wants=network-online.target

# Anti-flapping: stop the service if it crashes 5+ times in 5 minutes.
# Prevents infinite restart loops like the OOM→kill→restart cascade.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/autotube
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# Ensure DB is migrated, then start
# Use /bin/sh -c to safely handle semicolons in Python -c code
ExecStartPre=-/bin/sh -c '/usr/bin/python3 -c "from database.db import init_db; from database.db_extended import migrate_v2; init_db(); migrate_v2()"'
ExecStart=/usr/bin/python3 -m uvicorn api.main:app --host 0.0.0.0 --port 8000 --log-level info

# Auto-restart on crash, but stop if it flaps (prevents restart storms)
Restart=always
RestartSec=10

# Prioridad de CPU: menor que la de los capturadores de reconocimientoFacial
# (Tier 1, tiempo real). Los ffmpeg/TTS hijos heredan Nice=10.
Nice=10

# KillMode: process = SIGTERM only to the main process (uvicorn).
# Child processes (full_pipeline_worker subprocesses with start_new_session)
# survive the restart, preserving running video generations.
# Previously 'mixed' which SIGKILL'd the entire cgroup after TimeoutStopSec,
# killing all in-flight renders on every apply_changes.sh deployment.
KillMode=process
TimeoutStartSec=300
TimeoutStopSec=60

# Send SIGINT first (Python handles it better for clean shutdown),
# then SIGTERM if still alive after 30s.
KillSignal=SIGINT
SendSIGKILL=yes

# Watchdog: systemd will kill and restart the service if it doesn't
# send a watchdog ping for 180 seconds (indicates hung process).
WatchdogSec=180

# Hardening
NoNewPrivileges=no
PrivateTmp=no

[Install]
WantedBy=multi-user.target
