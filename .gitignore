# Secrets
.env
*.pickle
tokens/*
!tokens/.gitkeep
# Credenciales OAuth por canal (se dejaron de trackear: viven solo en disco)
config/client_secret*.json
# Mapa secreto slug -> {url, token} de los agentes egress (contiene tokens)
config/egress_agents.json
# Subidas temporales del agente egress
output/agent_uploads/

# Backups locales (nunca en git)
*.bak
# Backups de la base de datos (se dejaron de trackear)
autotube.db.backup*

# Output
output/*
!output/.gitkeep
!output/audio/.gitkeep
!output/images/.gitkeep
!output/videos/.gitkeep
!output/thumbnails/.gitkeep
!output/templates/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Logs
logs/*
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/

# Database
*.db
*.sqlite
# SQLite runtime artifacts (WAL/shm) and recovery backups
*.db-shm
*.db-wal
*.db.corrupt.*
